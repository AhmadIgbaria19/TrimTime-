# Copy to ".env" in this folder. Do not commit ".env".
# Port 3000 is often taken by other local projects.
# Docker Compose reads this file at runtime. It is not copied into the image.

CLIENT_PORT=3001
API_PORT=4000

# PostgreSQL
# Host tools (npm test:live, optional npm run dev) use 127.0.0.1 and the published port.
# Inside the app container, Compose overrides PGHOST=db and PGPORT=5432.
PGHOST=127.0.0.1
PGPORT=5434
PGUSER=trimtime
PGPASSWORD=change_me
PGDATABASE=trimtime

# Isolated database used by `npm run test:live`. Created automatically.
# Never point the running app at this name.
# PGDATABASE_TEST=trimtime_test

# Seeded on API startup for local use only. Change every value before any shared environment.
ADMIN_NAME=Salon Owner
ADMIN_PHONE=0500000001
ADMIN_PASSWORD=change_me
SESSION_SECRET=generate_a_long_random_string
