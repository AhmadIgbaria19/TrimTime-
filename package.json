{
  "name": "trimtime",
  "private": true,
  "workspaces": ["client", "server"],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "up": "docker compose up -d --build --wait",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "npm run migrate -w server",
    "test": "npm run test -w server",
    "test:live": "npm run test:live -w server",
    "typecheck": "tsc --noEmit -p client/tsconfig.json"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
